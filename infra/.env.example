# Local environment placeholders — copy to `.env` and adjust for your machine.
# Never commit real secrets.

DOCKER_REGISTRY=
VITE_API_GATEWAY_URL=
VITE_GATEWAY_URL=http://localhost:8080
VITE_NOTIFICATION_SERVICE_URL=http://localhost:5004

# LLM provider (ApprovalService). Default Stub needs no API key.
# Supported: Stub | Gemini | Groq | OpenRouter
# For external providers, put keys in infra/dapr/components/secrets.json:
#   LlmProvider.ApiKey         = primary key
#   LlmProvider.FallbackApiKey = fallback key (optional)
#
# Optional external example:
#   LlmProvider__Provider=Gemini
#   LlmProvider__FallbackProvider=Groq
#   LlmProvider__FallbackModel=llama-3.3-70b-versatile
#   LlmProvider__FallbackBaseUrl=https://api.groq.com/openai/v1/
#   LlmProvider__RetryCount=1
#   LlmProvider__RetryDelayMs=500
LlmProvider__Provider=Stub
LlmProvider__Model=stub
LlmProvider__BaseUrl=
LlmProvider__FallbackProvider=
LlmProvider__FallbackModel=
LlmProvider__FallbackBaseUrl=
LlmProvider__RetryCount=0
LlmProvider__RetryDelayMs=0
