{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ApprovalFlow",
    "Audience": "ApprovalFlow",
    "SigningKey": "",
    "ExpirationMinutes": 480
  },
  "ReverseProxy": {
    "Routes": {
      "submissions-create": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/submissions",
          "Methods": [ "POST" ]
        }
      },
      "submissions-list": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/submissions",
          "Methods": [ "GET" ]
        }
      },
      "submissions-get": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/submissions/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "audit-get": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/audit/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "reports-summary": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/reports/summary",
          "Methods": [ "GET" ]
        }
      },
      "reports-compliance": {
        "ClusterId": "intake",
        "Match": {
          "Path": "/reports/compliance",
          "Methods": [ "GET" ]
        }
      },
      "approvals-queue": {
        "ClusterId": "approval",
        "Match": {
          "Path": "/approvals/queue",
          "Methods": [ "GET" ]
        }
      },
      "approvals": {
        "ClusterId": "approval",
        "Match": {
          "Path": "/approvals/{**catch-all}"
        }
      },
      "policy": {
        "ClusterId": "approval",
        "Match": {
          "Path": "/policy",
          "Methods": [ "GET", "PUT" ]
        }
      },
      "notifications-get": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/notifications/{**catch-all}",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "intake": {
        "Destinations": {
          "intake-1": {
            "Address": "http://intakeservice:8080/"
          }
        }
      },
      "approval": {
        "Destinations": {
          "approval-1": {
            "Address": "http://approvalservice:8080/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "notification-1": {
            "Address": "http://notificationservice:8080/"
          }
        }
      }
    }
  }
}
