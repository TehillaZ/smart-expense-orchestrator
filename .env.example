# Local environment placeholders — copy to `.env` and adjust for your machine.
# Never commit real secrets.

DOCKER_REGISTRY=
VITE_API_GATEWAY_URL=
VITE_GATEWAY_URL=http://localhost:8080
VITE_NOTIFICATION_SERVICE_URL=http://localhost:5004

# LLM provider (ApprovalService). Default Stub keeps CI/local free of external calls.
# Set Provider=OpenRouter and put a real key in infra/dapr/components/secrets.json
# under "LlmProvider:ApiKey" (loaded via Dapr secret store).
LlmProvider__Provider=Stub
LlmProvider__Model=openai/gpt-4o-mini
LlmProvider__BaseUrl=https://openrouter.ai/api/v1
